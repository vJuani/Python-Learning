# Copy to .env for local development only.
# Never commit .env or real secrets to Git.
#
# IMPORTANT: Flask loads ONLY .env at runtime.
# Editing this file (.env.example) does nothing until you copy it to .env.
#
# Staging on Railway: set variables in the Railway dashboard (or CLI).
# See docs/DEPLOY_RAILWAY.md. Do not upload .env to Railway.

# development | staging | production
APP_ENV=development
FLASK_DEBUG=1

# Generate a strong value for staging/production, for example:
# python -c "import secrets; print(secrets.token_hex(32))"
# Required when APP_ENV is staging or production (dev-secret-key is rejected).
SECRET_KEY=change-me-in-local-env

# SQLite database path (relative or absolute). On Railway volume use e.g. /data/commission.db
DATABASE_PATH=commission.db

# Optional upload root for organization logos.
# Must stay under the app's static/ tree so Flask can serve them.
# Default: <app>/static/uploads (ephemeral on Railway unless you persist that path).
# UPLOAD_DIR=static/uploads

# Private document storage for VAT invoices (outside static/)
# PRIVATE_UPLOAD_ROOT=uploads
# On Railway volume: PRIVATE_UPLOAD_ROOT=/data/uploads

# CLI default tenant when using main.py
DEFAULT_ORGANIZATION_ID=1

# Local dev server bind (ignored by Gunicorn; Railway sets PORT)
HOST=127.0.0.1
PORT=5000

# Email backend: console (default for local) or smtp
EMAIL_BACKEND=console

# Public base URL used in verification / guest / login links
# Local: http://127.0.0.1:5000
# Staging: https://your-service.up.railway.app (or custom domain)
APP_BASE_URL=http://127.0.0.1:5000

# Optional public HTTPS URL for the product logo in emails.
# Mail clients cannot load localhost images; leave empty in local dev
# (emails still render with brand name + slogan as text fallback).
# EMAIL_LOGO_URL=https://cdn.example.com/logo-full.png

# SMTP (only when EMAIL_BACKEND=smtp)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=
# SMTP_USE_TLS=1
# EMAIL_FROM=onboarding@resend.dev
# SMTP_FROM=

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=DEBUG

# Cookie flags (defaults: Secure=on when APP_ENV is staging/production)
# SESSION_COOKIE_SECURE=1
# SESSION_COOKIE_SAMESITE=Lax

# --- Staging example (Railway Variables UI; do not put secrets here) ---
# APP_ENV=staging
# FLASK_DEBUG=0
# SECRET_KEY=<strong-random>
# APP_BASE_URL=https://your-service.up.railway.app
# DATABASE_PATH=/data/commission.db
# PRIVATE_UPLOAD_ROOT=/data/uploads
# # leave UPLOAD_DIR unset (logos under static/uploads)
# EMAIL_BACKEND=smtp
# SMTP_HOST=...
# SMTP_PORT=587
# SMTP_USERNAME=...
# SMTP_PASSWORD=...
# SMTP_USE_TLS=1
# EMAIL_FROM=...
# LOG_LEVEL=INFO
# SESSION_COOKIE_SECURE=1
