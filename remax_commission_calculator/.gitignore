# Python bytecode
__pycache__/
*.pyc
*.pyo

# Environment variables
.env
.env.local
.env.*
!.env.example

# Private keys / certificates
*.pem
*.key

# Local SQLite databases (incl. production snapshots and WAL sidecars)
*.db
*.db.bak.*
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
production_snapshot*

# Uploaded organization assets (public logos under static)
static/uploads/organizations/**/*
!static/uploads/organizations/.gitkeep

# Private operation documents (outside static/)
uploads/
!uploads/.gitkeep

# Logs
*.log

# Local email/dev scratch files
tmp_email_inbox.txt

# Local VAPID key material — never commit
vapid_private.txt
vapid_public.txt
vapid_*.txt

# Local data and generated exports
*.json
*.csv
*.xlsx

# Playwright browsers downloaded during build/dev
ms-playwright/

# HTML renderer debug dumps
tmp/marketing_html_render/
tmp/property_marketing_qa/e2e/
tmp/property_marketing_qa/chat_e2e/
tmp/*.txt

# Scratch files left by tests in the app root (8 random chars, no extension).
# git matches case-insensitively on Windows, so keep real root files visible.
/[a-z0-9_][a-z0-9_][a-z0-9_][a-z0-9_][a-z0-9_][a-z0-9_][a-z0-9_][a-z0-9_]
!/Procfile

# Excel temporary lock files
~$*
