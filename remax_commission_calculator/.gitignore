# Python bytecode
__pycache__/
*.pyc
*.pyo

# Environment variables
.env
.env.local

# Local SQLite databases
*.db
*.db.bak.*

# Uploaded organization assets (public logos under static)
static/uploads/organizations/**/*
!static/uploads/organizations/.gitkeep

# Private operation documents (outside static/)
uploads/
!uploads/.gitkeep

# Logs
*.log

# Local email/dev scratch files
tmp_email_inbox.txt

# Local VAPID key material — never commit
vapid_private.txt
vapid_public.txt
vapid_*.txt

# Local data and generated exports
*.json
*.csv
*.xlsx

# Playwright browsers downloaded during build/dev
ms-playwright/

# HTML renderer debug dumps
tmp/marketing_html_render/
tmp/property_marketing_qa/e2e/

# Excel temporary lock files
~$*
